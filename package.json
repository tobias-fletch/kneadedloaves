{
  "name": "micro-bakery",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "email:worker": "tsx scripts/email-worker.ts",
    "prisma:deploy": "prisma migrate deploy",
    "admin:setup": "tsx scripts/admin.ts",
    "secrets:encrypt": "tsx scripts/encrypt-config.ts",
    "backup": "tsx scripts/backup.ts",
    "payments:expire": "tsx scripts/payment-expiry.ts",
    "test:integration": "node --import tsx tests/manual-payments.integration.ts",
    "build:workers": "esbuild scripts/email-worker.ts scripts/payment-expiry.ts --bundle --platform=node --target=node22 --format=cjs --packages=external --outdir=dist-workers",
    "build:runtime": "npm run build:workers && esbuild next.config.ts --platform=node --target=node22 --format=esm --outfile=dist-workers/next.config.mjs",
    "email:worker:production": "node dist-workers/email-worker.js",
    "payments:expire:production": "node dist-workers/payment-expiry.js"
  },
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "next": "^15.5.28",
    "nodemailer": "~10.0.16",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "stripe": "^16.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.28",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.23",
    "prisma": "^6.10.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "esbuild": "^0.28.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "$postcss",
    "deepmerge-ts": "^8.0.0",
    "postcss-selector-parser": "^7.1.6",
    "source-map-js": "^1.2.2",
    "brace-expansion@^1.1.7": "^1.1.21",
    "brace-expansion@^5.0.8": "^5.0.12"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
