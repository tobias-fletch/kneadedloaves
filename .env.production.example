# Set secrets directly in the Netlify dashboard for Functions + Builds as needed.
# Never paste credentials into chat or commit real values.
NODE_ENV=production
APP_URL=https://kneadedloaves.com
NEXT_PUBLIC_APP_URL=https://kneadedloaves.com
# Neon dashboard pooled connection URL, TLS required, bounded connection_limit.
DATABASE_URL=
# Use Neon's direct connection URL only for one-off migration/backup commands.
DIRECT_DATABASE_URL=
JWT_SECRET=
# Preserve the existing key when importing encrypted AppConfig rows.
CONFIG_ENCRYPTION_KEY=
IMAGE_STORAGE_PROVIDER=netlify-blobs
NETLIFY_BLOBS_STORE=product-images
TRUST_PROXY=false
CONTACT_EMAIL=
CONTACT_PHONE=
# Live checkout stays OFF until every operational and provider test is verified.
CHECKOUT_ENABLED=false
OPERATIONS_CONFIRMED=false
CHECKOUT_SMOKE_TESTED=false
# Confirm legal applicability and one uniform rate for all supported products/ZIPs.
# 100 basis points = 1 percent. An intentional 0 is allowed. Blank blocks checkout.
TAX_RATE_BPS=
TAX_DELIVERY_FEE=
STRIPE_ENABLED=false
STRIPE_TEST_MODE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_ENABLED=false
PAYPAL_SANDBOX=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
