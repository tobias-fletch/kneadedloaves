# Copy to .env.production on the production host and fill every required blank.
# Never copy development credentials into production.
NODE_ENV=production
APP_URL=https://kneadedloaves.com
NEXT_PUBLIC_APP_URL=https://kneadedloaves.com
DATABASE_URL=
JWT_SECRET=
CONFIG_ENCRYPTION_KEY=
UPLOAD_DIR=/app/uploads
# Enable only when the reverse proxy replaces incoming X-Forwarded-For.
TRUST_PROXY=false
CONTACT_EMAIL=
CONTACT_PHONE=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Payments remain deferred; production checkout stays paused.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
