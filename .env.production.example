# Copy to .env.production on the production host and fill every required blank.
# Never copy development credentials into production.
NODE_ENV=production
APP_URL=https://kneadedloaves.com
NEXT_PUBLIC_APP_URL=https://kneadedloaves.com
DATABASE_URL=
JWT_SECRET=
CONFIG_ENCRYPTION_KEY=
UPLOAD_DIR=/app/uploads
# Enable only when the reverse proxy replaces incoming X-Forwarded-For.
TRUST_PROXY=false
CONTACT_EMAIL=kneadedloaves@gmail.com
# No public phone number. Leave CONTACT_PHONE empty.
CONTACT_PHONE=
# Site email is sent only through Resend (sending-only key scoped to kneadedloaves.com).
# Set it in Vercel, never in Admin > Setup.
RESEND_API_KEY=
# Vercel Cron sends Authorization: Bearer $CRON_SECRET. Rejected when unset.
# Schedules are once per day (Hobby). Generate a long random value.
CRON_SECRET=
# Checkout stays off until every readiness gate passes. This is not a code hard-stop.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

VENMO_CHECKOUT_ENABLED=false
VENMO_HANDLE=
VENMO_DESTINATION=
VENMO_DESTINATION_VERIFIED=false
VENMO_VERIFIED_FINGERPRINT=
PAYMENT_HOLD_MINUTES=
PAYMENT_WORKERS_READY=false
CHECKOUT_SMOKE_TESTED=false
