DATABASE_URL="postgresql://postgres:postgres@localhost:5432/micro_bakery?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
# Exactly 64 random hexadecimal characters. Back up separately from the database.
CONFIG_ENCRYPTION_KEY=""
# Persistent directory for new uploaded images. Defaults to ./uploads.
UPLOAD_DIR=""
# Enable only behind a proxy that replaces X-Forwarded-For.
TRUST_PROXY="false"
CONTACT_EMAIL="kneadedloaves@gmail.com"
# Contact form sends real mail only when VERCEL_ENV=production AND this is "true" (Production only).
CONTACT_LIVE_SEND=""
# The bakery has no public phone number. Leave this empty.
CONTACT_PHONE=""

# Stripe checkout
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Vercel Cron calls /api/cron/* with Authorization: Bearer $CRON_SECRET.
# Hobby cron runs once per day. Checkout also sends that order's email immediately on Vercel.
CRON_SECRET=""
# Run npm run email:worker separately to deliver queued email outside Vercel.
# Site email is sent only through Resend, From noreply@kneadedloaves.com with
# Reply-To kneadedloaves@gmail.com. Leave empty locally to send nothing.
RESEND_API_KEY=""

# Social posting APIs. Missing credentials keep posts Approved/Scheduled with warnings.
INSTAGRAM_GRAPH_TOKEN=""
FACEBOOK_PAGE_TOKEN=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# Manual payments remain disabled until owner setup, workers and testing are complete.
VENMO_CHECKOUT_ENABLED=false
VENMO_HANDLE=
VENMO_DESTINATION=
VENMO_DESTINATION_VERIFIED=false
VENMO_VERIFIED_FINGERPRINT=
PAYMENT_HOLD_MINUTES=
PAYMENT_WORKERS_READY=false

# Cloudflare Web Analytics site token (public, cookieless beacon). Optional override:
# leave empty to use the committed kneadedloaves.com token in lib/cloudflare-analytics.ts.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=""
# Google Search Console URL-prefix verification (HTML tag content value; public). Optional override:
# leave empty to use the committed kneadedloaves.com value in lib/cloudflare-analytics.ts.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
